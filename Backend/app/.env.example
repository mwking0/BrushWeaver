# Google Gemini Configuration
# Get an API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini model (optional override)
# Defaults to gemini-2.5-flash-image if unset
# Other image-capable options for your key:
#   - gemini-3.1-flash-image       (newer flash, often faster + cheaper)
#   - gemini-3-pro-image           (pro tier, highest quality, most expensive)
# GEMINI_MODEL=gemini-2.5-flash-image

# Authentication Configuration
# IMPORTANT: Change this in production!
SECRET_KEY=your-super-secret-key-change-this-in-production-please

# Database Configuration
# SQLite for development (default)
DATABASE_URL=sqlite:///./brushweaver.db
# PostgreSQL for production (example):
# DATABASE_URL=postgresql://user:password@localhost/brushweaver

# OAuth Configuration (Optional)
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Server Configuration (Optional)
# HOST=127.0.0.1
# PORT=8000
# RELOAD=True

# CORS Origins (Optional)
# Add your frontend URLs here
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
