# Local AI Model Configuration
# Available models (download first with: python qwen/setup_qwen.py):
#   - qwen-image-edit (RECOMMENDED: best for editing, 10GB, excellent quality)
#   - sdxl-turbo (fastest, 7GB, excellent quality)
#   - sd-turbo (fast, 5GB, good quality)
#   - stable-diffusion-xl (high quality, 7GB, slower)
#   - realistic-vision (photorealistic, 5GB)
LOCAL_MODEL_NAME=qwen-image-edit

# Model Directory (Optional)
# Where to look for downloaded models
# Default: Backend/models/
# MODEL_DIR=Backend/models

# Authentication Configuration
# IMPORTANT: Change this in production!
SECRET_KEY=your-super-secret-key-change-this-in-production-please

# Database Configuration
# SQLite for development (default)
DATABASE_URL=sqlite:///./brushweaver.db
# PostgreSQL for production (example):
# DATABASE_URL=postgresql://user:password@localhost/brushweaver

# OAuth Configuration (Optional)
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Server Configuration (Optional)
# HOST=127.0.0.1
# PORT=8000
# RELOAD=True

# CORS Origins (Optional)
# Add your frontend URLs here
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173